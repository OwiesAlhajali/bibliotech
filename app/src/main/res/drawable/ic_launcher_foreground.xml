<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Premium Book Shape -->
    <path
        android:pathData="M50,30 Q35,25 20,40 L20,85 Q35,80 50,75 M58,30 Q73,25 88,40 L88,85 Q73,80 58,75"
        android:strokeColor="#F59E0B"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Integrated Magnifying Glass -->
    <path
        android:pathData="M75,65 m-15,0 a15,15 0 1,1 30,0 a15,15 0 1,1 -30,0"
        android:strokeColor="#F59E0B"
        android:strokeWidth="3" />

    <!-- Glass Lens Effect -->
    <path
        android:pathData="M75,65 m-13.5,0 a13.5,13.5 0 1,1 27,0 a13.5,13.5 0 1,1 -27,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="61.5"
                android:startY="51.5"
                android:endX="88.5"
                android:endY="78.5"
                android:type="linear">
                <item android:offset="0" android:color="#4DFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Handle -->
    <path
        android:pathData="M85.6,75.6 L96,86"
        android:strokeColor="#F59E0B"
        android:strokeWidth="4"
        android:strokeLineCap="round" />

    <!-- Digital Tech Nodes -->
    <path
        android:pathData="M30,45 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:fillColor="#F59E0B" />
    <path
        android:pathData="M27,55 m-1.5,0 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0"
        android:fillColor="#F59E0B" />
    <path
        android:pathData="M35,65 m-1.5,0 a1.5,1.5 0 1,1 3,0 a1.5,1.5 0 1,1 -3,0"
        android:fillColor="#F59E0B" />

    <!-- Connection Line -->
    <path
        android:pathData="M30,45 L40,45"
        android:strokeColor="#66F59E0B"
        android:strokeWidth="1" />

</vector>
